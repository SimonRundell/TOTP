# Never expose configuration files to the browser.
<Files ".config.json">
    Require all denied
</Files>

RewriteEngine On

# Let real files and directories resolve normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to index.html.
RewriteRule ^ index.html [L]
